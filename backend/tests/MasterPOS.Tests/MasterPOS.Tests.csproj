<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Application (+ its own transitive Domain/Infrastructure refs) plus the
         Api project itself, whose Program class WebApplicationFactory boots
         to run these as real, full-stack HTTP integration tests — the same
         "real system, not mocked" standard every other layer of this project
         was held to. -->
    <ProjectReference Include="..\..\src\MasterPOS.Application\MasterPOS.Application.csproj" />
    <ProjectReference Include="..\..\src\MasterPOS.Infrastructure\MasterPOS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MasterPOS.Api\MasterPOS.Api.csproj" />
  </ItemGroup>

</Project>
